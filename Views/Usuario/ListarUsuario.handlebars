<table class="table">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Senha</th>
            <th scope="col">Tipo</th>
            <th scope="col">Email</th>
            <th scope="col">Ativo</th>
            <th scope="col">Link</th>
            <th scope="col">Id</th>
            {{#if admin}}
            <th scope="col">Editar</th>
            <th scope="col">Deletar</th>
            {{/if}}
        </tr>
    </thead>
    <tbody>
        {{#each usuario}}
        <tr>
            <th scope="row">{{nome}}</th>
            <td>{{senha}}</td>
            <td>{{tipo}}</td>
            <td>{{email}}</td>
            <td>{{ativo}}</td>
            <td>{{link}}</td>
            <td>{{id}}</td>
            {{#if ../admin}}
            <td><a href="atualizarUsuario/{{id}}">Editar</a></td>
            <td><a href="deletarUsuario/{{id}}">Deletar</a></td>
            {{/if}}
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/home" class="btn btn-secondary">Voltar</a>