<form action="/atualizarUsuario" method="post">
    <input type="hidden" name="id" value={{usuario.id}}>
    <div class="form-group">
        <label for="inputNome">Nome</label>
        <input type="text" class="form-control" id="inputNome" name="nome" value="{{usuario.nome}}">
    </div>
    <div class="form-group">
        <label for="inputSenha">Senha</label>
        <input type="text" class="form-control" id="inputSenha" name="senha"  value="{{usuario.senha}}">
    </div>
    <div class="form-group">
        <label for="inputTipo">Tipo</label>
        <select class="form-control" id="inputTipo" name="tipo">
            <option value="aluno">Aluno</option>
            <option value="admin">Administrador</option>
        </select>
    </div>
    <br><br>
    <button type="submit" class="btn btn-primary">Atualizar Usuario</button>
</form>