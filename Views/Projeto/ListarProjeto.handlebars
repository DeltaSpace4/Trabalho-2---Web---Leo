<table class="table">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Resumo</th>
            <th scope="col">Link</th>
            <th scope="col">Id</th>
            {{#if admin}}
            <th scope="col">Editar</th>
            <th scope="col">Deletar</th>
            {{/if}}
        </tr>
    </thead>
    <tbody>
        {{#each projeto}}
        <tr>
            <th scope="row">{{nome}}</th>
            <td>{{resumo}}</td>
            <td>{{link}}</td>
            <td>{{id}}</td>
            {{#if ../admin}}
            <td><a href="atualizarProjeto/{{id}}">Editar</a></td>
            <td><a href="deletarProjeto/{{id}}">Deletar</a></td>
            {{/if}}
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/home" class="btn btn-secondary">Voltar</a>