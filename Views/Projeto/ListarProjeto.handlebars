<table class="table">
    <thead>
        <tr>
            <th scope="col">Nome</th>
            <th scope="col">Resumo</th>
            <th scope="col">Link</th>
            <th scope="col">Id</th>
            <th scope="col">Ações</th>
        </tr>
    </thead>
    <tbody>
        {{#each projeto}}
        <tr>
            <th scope="row">{{nome}}</th>
            <td>{{resumo}}</td>
            <td>{{link}}</td>
            <td>{{id}}</td>
            <td>
                {{#if canEdit}}
                <a href="atualizarProjeto/{{id}}" class="btn btn-sm btn-primary">Editar</a>
                <a href="deletarProjeto/{{id}}" class="btn btn-sm btn-danger">Deletar</a>
                {{else}}
                <span class="text-muted">Sem permissão</span>
                {{/if}}
        </tr>
        {{/each}}
    </tbody>
</table>
<a href="/home" class="btn btn-secondary">Voltar</a>