{{#if canEdit}}
<form action="/atualizarProjeto" method="post">
    <input type="hidden" name="id" value={{projeto.id}}>
    <div class="form-group">
        <label for="inputNome">Novo Nome</label>
        <input type="text" class="form-control" id="inputNome" name="nome" value="{{projeto.nome}}">
    </div>
    <div class="form-group">
        <label for="inputResumo">Novo Resumo</label>
        <input type="text" class="form-control" id="inputResumo" name="resumo" value="{{projeto.resumo}}">
    </div>
    <div class="form-group">
        <label for="inputLink">Novo Link</label>
        <input type="text" class="form-control" id="inputLink" name="link" value="{{projeto.link}}">
    </div>
    <br>
    <button type="submit" class="btn btn-primary">Atualizar Projeto</button>
    <a href="/home" style="margin-left:10px;">Voltar</a>
</form>
<!-- Tags form: select multiple tags and submit to update associations -->
<form action="/atualizarProjetoTags" method="post">
    <input type="hidden" name="projetoId" value="{{projeto.id}}">
    <label>Tags (marque as que devem ficar vinculadas)</label>
    <table class="table">
    <thead>
        <tr>
            <th scope="col">Vincular</th>
            <th scope="col">Nome</th>
            <th scope="col">Id</th>
        </tr>
    </thead>
    <tbody>
        {{#each tag}}
        <tr>
            <td>
                <input type="checkbox" name="tagIds" value="{{id}}" {{#if linked}}checked{{/if}}>
            </td>
            <th scope="row">{{nome}}</th>
            <td>{{id}}</td>
        </tr>
        {{/each}}
    </tbody>
    </table>
    <br>
    <button type="submit" class="btn btn-primary">Salvar Tags</button>
</form>

<hr>

<!-- Users form: select multiple users and submit to update associations -->
<form action="/atualizarProjetoUsuarios" method="post">
    <input type="hidden" name="projetoId" value="{{projeto.id}}">
    <label>Usuários (marque os que devem ter acesso ao projeto)</label>
    <table class="table">
    <thead>
        <tr>
            <th scope="col">Vincular</th>
            <th scope="col">Nome</th>
            <th scope="col">Email</th>
            <th scope="col">Tipo</th>
        </tr>
    </thead>
    <tbody>
        {{#each usuarios}}
        <tr>
            <td>
                <input type="checkbox" name="usuarioIds" value="{{id}}" {{#if linked}}checked{{/if}}>
            </td>
            <th scope="row">{{nome}}</th>
            <td>{{email}}</td>
            <td>{{tipo}}</td>
        </tr>
        {{/each}}
    </tbody>
    </table>
    <br>
    <button type="submit" class="btn btn-primary">Salvar Usuários</button>
</form>
{{else}}
<div class="alert alert-info">
    Você não tem permissão para editar este projeto. Entre em contato com o administrador para solicitar acesso.
</div>
<div class="card">
    <div class="card-body">
        <h5 class="card-title">{{projeto.nome}}</h5>
        <p class="card-text">{{projeto.resumo}}</p>
        <a href="{{projeto.link}}" target="_blank" class="card-link">Link do Projeto</a>
    </div>
</div>
{{/if}}